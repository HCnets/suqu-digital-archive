# Production runtime
NODE_ENV=production
PORT=3001
DB_CLIENT=mysql

# Keep data outside public web roots. Uploads and backup snapshots are stored below this directory.
DATA_DIR=/www/wwwroot/szht-data

# Public domains allowed to call the API. Keep both display and admin domains.
CORS_ORIGIN=https://szht.online,https://admin.szht.online
SESSION_COOKIE_DOMAIN=admin.szht.online

# Leave empty unless the legacy token interface must be temporarily kept.
ADMIN_TOKEN=

# MySQL production database. Use a strong password created on the server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=szht_cms
DB_USER=szht_user
DB_PASSWORD=replace-with-production-password
DB_CONNECTION_LIMIT=10

# Optional: used by public API parity smoke tests when the server is not local.
PUBLIC_API_BASE_URL=http://127.0.0.1:3001
